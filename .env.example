# ---------------------------------------------------------------------------
# lead-engine environment
#
# PLACEHOLDERS ONLY. Never commit real credentials to this file.
# Copy to .env and fill in only what the selected providers require.
#
# The defaults below are the $0 development and demo path:
#   - n8n           : running locally / self-hosted by the developer
#   - LLM           : Ollama on localhost, local open-source model
#   - Persistence   : mock CRM adapter (JSON file on disk, no hosted service)
#   - Outbound      : dry-run, so nothing is actually sent
# No paid API key is needed to develop, test, or demo this project.
# ---------------------------------------------------------------------------

# --- LLM provider -----------------------------------------------------------
# ollama (default, local, free) | anthropic | openai
# Switching providers is configuration-only: no edits to src/core/, prompts,
# generated snippets, workflow topology, or the data schema.
LLM_PROVIDER=ollama

# Local Ollama runtime. Keep this bound to localhost/trusted network only —
# Ollama is not a security boundary and its output is treated as untrusted.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Applies to every provider call. Every call is timed out and bounded-retried.
LLM_TIMEOUT_MS=30000

# --- Optional hosted providers ----------------------------------------------
# Leave empty unless LLM_PROVIDER is switched to that provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Persistence ------------------------------------------------------------
# mock (default, local JSON file) | supabase (hosted Postgres, Free tier)
CRM_ADAPTER=mock

# Only needed when CRM_ADAPTER=supabase.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Inbound webhook auth ---------------------------------------------------
# Shared secret expected in the X-Lead-Token header, compared in constant time.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=

# --- Outbound integrations --------------------------------------------------
SLACK_WEBHOOK_URL=
GOOGLE_SHEET_ID=

# --- Business rules ---------------------------------------------------------
# IANA timezone used for business-hours clamping of follow-up send times.
BUSINESS_TZ=America/Los_Angeles

# Score at or above this is HOT and triggers the Slack alert.
HOT_SCORE_THRESHOLD=75

# --- Safety -----------------------------------------------------------------
# true  = outbound messages are logged, never sent. Safe to run repeatedly.
# false = messages actually go out. Set deliberately, never by default.
DRY_RUN=true
