# Dependencies
node_modules/

# Secrets — .env.example is committed, real .env files never are
.env
.env.local
.env.*.local
!.env.example

# Local mock CRM state (mockCrm.js persists here; demo data, not source)
.data/

# Test + tooling output
coverage/
*.log
npm-debug.log*

# Graphify local repo graph (agent-side developer tooling, spec section 13.1 —
# never a runtime dependency, never read as part of the product)
graphify-out/

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini

# Claude Code local overrides. Project skills under .claude/skills/ ARE committed;
# machine-local permission grants are not.
.claude/settings.local.json
